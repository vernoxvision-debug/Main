# Vernox Vision Environment Variables & Secrets
# Set these in Replit Secrets (or in your local .env file)

# 1. Meta Pixel Tracking ID (e.g. 1234567890123456)
VITE_META_PIXEL_ID=

# 2. Gumroad Product URL (e.g. https://yourbrand.gumroad.com/l/yourproduct)
VITE_GUMROAD_PRODUCT_URL=

# 3. Customer Support Email
VITE_SUPPORT_EMAIL=support@vernoxvision.com

# 4. Custom Domain Base URL (e.g. https://vernoxvision.com)
VITE_SITE_URL=https://vernoxvision.com
